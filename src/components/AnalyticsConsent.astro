---
const googleAnalyticsId = "G-RK8VRLQ1ND";
---

<div
  class="analytics-consent"
  data-analytics-consent
  data-analytics-id={googleAnalyticsId}
  data-consent="unset"
>
  <section
    class="consent-banner"
    data-consent-banner
    aria-labelledby="consent-banner-title"
    hidden
  >
    <div>
      <p class="consent-kicker">Privacy</p>
      <h2 id="consent-banner-title">Optional site analytics</h2>
      <p>
        I would like to use Google Analytics to understand which pages are useful. No Google
        Analytics code loads unless you allow it.
      </p>
      <a href="/privacy/">How analytics and your choice are handled</a>
    </div>
    <div class="consent-actions" aria-label="Analytics consent choices">
      <button class="consent-button consent-button-primary" type="button" data-consent-choice="granted">
        Allow analytics
      </button>
      <button class="consent-button consent-button-quiet" type="button" data-consent-choice="denied">
        Decline analytics
      </button>
    </div>
  </section>

  <button
    class="consent-settings"
    type="button"
    data-open-analytics-settings
    aria-haspopup="dialog"
    hidden
  >
    Analytics settings
  </button>

  <dialog class="consent-dialog" data-consent-dialog aria-labelledby="consent-dialog-title">
    <div class="consent-dialog-panel">
      <div class="consent-dialog-heading">
        <div>
          <p class="consent-kicker">Privacy</p>
          <h2 id="consent-dialog-title">Analytics preferences</h2>
        </div>
        <button class="consent-close" type="button" data-consent-close aria-label="Close analytics settings">
          Close
        </button>
      </div>
      <div class="consent-choice-row">
        <div>
          <h3>Optional analytics</h3>
          <p>
            Used to understand aggregate site traffic and useful pages. Advertising and
            personalised marketing are not used.
          </p>
          <a href="/privacy/">Read the privacy information</a>
        </div>
        <p class="consent-status" data-consent-status aria-live="polite">Not decided</p>
      </div>
      <div class="consent-dialog-actions">
        <button class="consent-button consent-button-primary" type="button" data-consent-choice="granted">
          Allow analytics
        </button>
        <button class="consent-button consent-button-secondary" type="button" data-consent-choice="denied">
          Decline analytics
        </button>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { initializeAnalyticsConsent } from "../scripts/consent";

  initializeAnalyticsConsent();
</script>

<style>
  .consent-banner[hidden],
  .consent-settings[hidden] {
    display: none;
  }

  .consent-banner {
    position: fixed;
    z-index: 120;
    right: 50%;
    bottom: 1rem;
    display: grid;
    overflow: hidden;
    width: var(--shell);
    border: 1px solid var(--ink);
    border-radius: 2px;
    color: var(--ink);
    background: var(--paper);
    box-shadow: 0 18px 50px rgb(11 23 33 / 0.16);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    transform: translateX(50%);
  }

  .consent-banner > div:first-child {
    padding: clamp(1.35rem, 2.6vw, 2rem);
  }

  .consent-banner h2,
  .consent-dialog h2 {
    font-family: var(--font-display);
    font-weight: 400;
    margin-bottom: 0.75rem;
    font-size: var(--text-h3);
    letter-spacing: -0.025em;
    line-height: 0.96;
  }

  .consent-banner p:not(.consent-kicker) {
    max-width: 52ch;
    margin-bottom: 0.55rem;
    color: var(--muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .consent-kicker {
    margin-bottom: 0.65rem;
    color: var(--teal);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .consent-banner a {
    color: var(--teal);
    font-size: var(--text-small);
    font-weight: 700;
  }

  .consent-actions,
  .consent-dialog-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .consent-actions {
    display: grid;
    align-content: end;
    padding: clamp(1.35rem, 2.6vw, 2rem);
    border-left: 1px solid var(--mist);
    background: var(--white);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .consent-button,
  .consent-settings,
  .consent-close {
    min-height: 46px;
    border: 1px solid currentColor;
    border-radius: 8px;
    font-weight: 750;
    line-height: 1.1;
    cursor: pointer;
  }

  .consent-button {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: var(--text-small);
    white-space: nowrap;
  }

  .consent-button-primary {
    border-color: var(--ink);
    color: var(--paper);
    background: var(--ink);
  }

  .consent-button-primary:hover {
    border-color: var(--teal);
    background: var(--teal);
  }

  .consent-button-quiet {
    color: var(--ink);
    background: transparent;
  }

  .consent-button-quiet:hover {
    color: var(--ink);
    background: var(--paper-deep);
  }

  .consent-button-secondary {
    color: var(--ink);
    background: transparent;
  }

  .consent-button-secondary:hover {
    color: var(--paper);
    background: var(--ink);
  }

  .consent-settings {
    position: fixed;
    z-index: 90;
    right: 0.75rem;
    bottom: 0.75rem;
    min-height: 40px;
    padding: 0.55rem 0.75rem;
    border-color: var(--mist);
    color: var(--ink);
    background: var(--paper);
    box-shadow: none;
    font-size: var(--text-meta);
  }

  .consent-settings:hover {
    border-color: var(--ink);
    background: var(--paper-deep);
  }

  .consent-dialog {
    width: min(760px, calc(100% - 2rem));
    max-width: none;
    padding: 0;
    border: 0;
    color: var(--ink);
    background: transparent;
  }

  .consent-dialog::backdrop {
    background: rgb(11 23 33 / 0.62);
  }

  .consent-dialog-panel {
    overflow: hidden;
    padding: 0;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: var(--paper);
    box-shadow: 0 24px 70px rgb(11 23 33 / 0.22);
  }

  .consent-dialog-heading {
    display: grid;
    align-items: start;
    gap: 1.5rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    border-bottom: 1px solid var(--mist);
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .consent-dialog .consent-kicker {
    color: var(--teal);
  }

  .consent-close {
    min-height: 42px;
    padding: 0.65rem 0.8rem;
    color: var(--ink);
    background: transparent;
  }

  .consent-close:hover {
    color: var(--paper);
    background: var(--ink);
  }

  .consent-choice-row {
    display: grid;
    align-items: start;
    gap: 2rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    border-bottom: 1px solid var(--mist);
    background: var(--white);
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .consent-choice-row h3 {
    margin-bottom: 0.5rem;
    font-size: var(--text-lead);
  }

  .consent-choice-row p {
    max-width: 48ch;
    margin-bottom: 0.5rem;
    color: var(--muted);
  }

  .consent-choice-row a {
    color: var(--teal);
    font-size: var(--text-small);
    font-weight: 700;
  }

  .consent-status {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--teal);
    border-radius: 2px;
    color: var(--ink) !important;
    background: var(--paper);
    font-size: var(--text-meta);
    font-weight: 700;
    white-space: nowrap;
  }

  .consent-dialog-actions {
    display: grid;
    padding: clamp(1.1rem, 2.5vw, 1.5rem) clamp(1.35rem, 3vw, 2rem);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 699px) {
    .consent-banner {
      bottom: 0.625rem;
      width: calc(100% - 1.25rem);
      grid-template-columns: 1fr;
    }

    .consent-banner > div:first-child {
      padding: 1.25rem;
    }

    .consent-banner h2,
    .consent-dialog h2 {
      font-size: var(--text-h3);
    }

    .consent-actions {
      padding: 1rem 1.25rem 1.25rem;
      border-top: 1px solid var(--mist);
      border-left: 0;
    }

    .consent-actions .consent-button {
      min-width: 0;
      padding-inline: 0.5rem;
      font-size: var(--text-small);
    }

    .consent-choice-row {
      grid-template-columns: 1fr;
    }

    .consent-status {
      width: fit-content;
    }

    .consent-dialog-heading,
    .consent-choice-row {
      padding: 1.25rem;
    }

    .consent-dialog-actions {
      padding: 1rem 1.25rem 1.25rem;
    }

    .consent-dialog-actions .consent-button {
      padding-inline: 0.5rem;
      font-size: var(--text-small);
    }
  }
</style>
