---
import { navigation } from "../data/profile";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) =>
  href.startsWith("http") ? false : currentPath === href || currentPath.startsWith(href);
---

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Eero Siivola, home">
      <span>Eero Siivola</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
                class:list={{ contact: item.label === "Contact" }}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="mobile-menu" data-mobile-menu>
      <summary aria-label="Open navigation menu">
        <span class="menu-label">Menu</span>
        <span class="menu-mark" aria-hidden="true"></span>
      </summary>
      <nav class="mobile-panel" data-mobile-panel aria-label="Mobile navigation">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
