---
import type { WorkItem } from "../data/work";

interface Props {
  item: WorkItem;
  index: number;
}

const { item, index } = Astro.props;
---

<article class:list={["work-card", `work-card-${index + 1}`]} id={item.id}>
  <div class="work-card-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
  <div class="work-card-body">
    <p class="kicker">{item.eyebrow}</p>
    <h3>{item.title}</h3>
    <p class="work-summary">{item.summary}</p>
    <ul class="tag-list" aria-label="Topics">
      {item.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <a class="text-link" href={`/work/#${item.id}`}>
      Details and sources
    </a>
  </div>
</article>
