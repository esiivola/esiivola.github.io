---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile";
import { researchItems } from "../../data/research";
---

<BaseLayout
  title="Research and open source | Eero Siivola"
  description="Selected research, applied publications, and open-source work by Eero Siivola."
>
  <header class="page-hero research-hero">
    <div class="shell page-hero-grid">
      <h1>Selected research and applied work.</h1>
      <p>
        This selection highlights recent applied work alongside research connected to my doctoral
        collaborations with Amazon and Novartis. My dissertation and open-source work provide the
        broader technical background. Google Scholar has the{" "}
        <a href={profile.social.scholar}>full publication record</a>.
      </p>
    </div>
  </header>

  <section class="section archive-section">
    <div class="shell archive-grid archive-grid-single">
      <div class="research-list">
        {
          researchItems.map((item) => (
            <article class="research-item">
              <p class="article-meta">{item.context} · {item.year}</p>
              <h2>{item.title}</h2>
              <p>{item.summary}</p>
              <ul class="tag-list" aria-label="Research themes">
                {item.themes.map((theme) => <li>{theme}</li>)}
              </ul>
              <div class="research-links">
                {item.links.map((link) => (
                  <a class="text-link" href={link.href}>
                    {link.label}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
