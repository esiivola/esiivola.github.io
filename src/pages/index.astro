---
import BaseLayout from "../layouts/BaseLayout.astro";
import Portrait from "../components/Portrait.astro";
import { profile } from "../data/profile";
import { researchItems } from "../data/research";
import { externalCase } from "../data/work";
import { writingItems } from "../data/writing";

const recentResearch = researchItems.find((item) => item.context === "Recent research");
const appliedGuide = writingItems.find((item) => item.format === "Guide");
---

<BaseLayout>
  <section class="identity-hero">
    <div class="shell identity-grid">
      <div class="identity-copy">
        <p class="eyebrow">Data Scientist & AI Architect · Helsinki</p>
        <h1>Eero Siivola</h1>
        <p class="identity-lead">
          I turn uncertain data into AI and decision systems that people can trust and use.
        </p>
        <p class="identity-role">
          From problem framing to delivery, I work across models, data workflows, software, and
          the operating process around them. I am a Senior Data Scientist at Vuono Group.
        </p>
        <div class="identity-links">
          <a class="text-link" href="#selected-work">Selected work</a>
          <a class="text-link" href="/writing/">Writing and research</a>
          <a class="text-link" href="/about/">About</a>
        </div>
      </div>
      <figure class="identity-portrait">
        <Portrait variant="hero" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="identity-proof" aria-label="At a glance">
    <div class="shell">
      <ul>
        <li>10+ years applying machine learning</li>
        <li>PhD in probabilistic machine learning</li>
        <li>5+ years leading projects from idea to delivery</li>
        <li>3 years leading a ten-person research team</li>
      </ul>
    </div>
  </section>

  <section class="selected-case section-dark" id="selected-work">
    <div class="shell selected-case-grid">
      <div class="selected-case-label">
        <p class="kicker">Selected work</p>
        <p>Public case · Vuono Group</p>
      </div>
      <article>
        <h2>From uncertain measurements to a repeatable R&D system.</h2>
        <p>{externalCase.summary}</p>
        <p>
          The result connected measured and synthetic data, repeatable benchmarking, and modular
          signal-processing software prepared for embedded development.
        </p>
        <a class="text-link" href={externalCase.href}>Read the public case at Vuono Group</a>
      </article>
    </div>
  </section>

  <section class="section home-evidence-index">
    <div class="shell">
      <div class="home-evidence-heading">
        <div>
          <p class="kicker">Public work</p>
          <h2>Ideas tested in practice.</h2>
        </div>
        <p>
          Selected writing and research on the same question from different angles: how to make
          data and machine learning useful in real decisions.
        </p>
      </div>
      <div class="home-evidence-list">
        {
          writingItems.slice(0, 2).map((item) => (
            <article>
              <p class="article-meta">{item.format} · {item.source} · {item.date}</p>
              <div>
                <h3><a href={item.href}>{item.title}</a></h3>
                <p>{item.abstract}</p>
              </div>
            </article>
          ))
        }
        {
          appliedGuide && (
            <article>
              <p class="article-meta">Applied guide · {appliedGuide.source} · {appliedGuide.date}</p>
              <div>
                <h3><a href={appliedGuide.href}>{appliedGuide.title}</a></h3>
                <p>{appliedGuide.abstract}</p>
              </div>
            </article>
          )
        }
        {
          recentResearch && (
            <article>
              <p class="article-meta">{recentResearch.context} · {recentResearch.year}</p>
              <div>
                <h3><a href={recentResearch.links[0].href}>{recentResearch.title}</a></h3>
                <p>{recentResearch.summary}</p>
              </div>
            </article>
          )
        }
      </div>
      <a class="text-link home-evidence-more" href="/writing/">See writing and selected research</a>
    </div>
  </section>

  <section class="identity-contact">
    <div class="shell identity-contact-grid">
      <div>
        <p class="kicker">Contact</p>
        <h2>Start a conversation about a difficult data or AI problem.</h2>
      </div>
      <p>
        I work with clients through Vuono Group. The best way to reach me directly is LinkedIn.
        <a class="text-link" href={profile.social.linkedin}>Connect on LinkedIn</a>
      </p>
    </div>
  </section>
</BaseLayout>
